  "landing": {
    "hero": {
      "title": "A Farm-to-Table Feast\nin the Hudson Valley",
      "subtitle": "Experience authentic Mongolian & Northeastern Chinese cuisine in our cozy yurts, surrounded by the rolling hills of New York's beautiful Hudson Valley",
      "bookVisit": "Book Your Visit",
      "viewMenu": "View Menu"
    },
    "about": {
      "title": "Our Story",
      "para1": "Nestled in the serene Hudson Valley, Bobo's Farm brings the bold, soulful flavors of Mongolian and Northeastern Chinese cuisine to your table. Our signature whole roasted lamb — slow-cooked over an open flame — is a celebration of tradition, community, and the land.",
      "para2": "Dine inside one of our authentic Mongolian yurts, surrounded by rolling pastures and fresh mountain air. Every ingredient is sourced from local farms or grown right here on our property.",
      "phone": "(516) 272-9999",
      "location": "Hudson Valley, New York"
    },
    "highlights": {
      "title": "What Makes Us Special",
      "subtitle": "Three reasons to gather around our table",
      "lamb": {
        "title": "Signature Roasted\nWhole Lamb",
        "desc": "Our showstopper: a whole lamb slow-roasted over an open flame for hours, seasoned with traditional Mongolian spices. Feeds 10-15 guests — perfect for celebrations."
      },
      "yurt": {
        "title": "Dine in a Yurt",
        "desc": "Step into one of our authentic Mongolian yurts for a truly unique dining experience. Warm, intimate, and beautifully decorated — each yurt seats up to 20 guests."
      },
      "farm": {
        "title": "Farm Fresh",
        "desc": "From our pastures to your plate. We raise our own livestock and grow seasonal vegetables on-site, ensuring the freshest, most flavorful ingredients in every dish."
      }
    },
    "howItWorks": {
      "title": "How It Works",
