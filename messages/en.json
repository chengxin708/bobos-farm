  "landing": {
    "hero": {
      "title": "Whole Roasted Lamb\nin a Yurt",
      "subtitle": "The Hudson Valley's most unique dining experience — authentic Chinese roasted whole lamb served in traditional Mongolian yurts. By appointment only.",
      "bookVisit": "Reserve Your Yurt",
      "viewMenu": "View Menu"
    },
    "about": {
      "title": "Our Story",
      "para1": "Bobo's Farm is the only place in the Hudson Valley where you can feast on a whole Chinese roasted lamb inside a traditional Mongolian yurt. Owner Jimmy and his wife Bobo — \"the real boss and a genius on cooking\" — have created something truly special on their farm in New Paltz.",
      "para2": "Gather your friends and family, put on your gloves, and tear into 35 pounds of perfectly spiced, slow-roasted lamb. With three colorful yurts nestled among the trees, farm-raised poultry, and karaoke to top it off — this is a celebration, not just a meal.",
      "phone": "(516) 272-9999",
      "location": "891 Albany Post Rd, New Paltz, NY 12561"
    },
    "highlights": {
      "title": "What Makes Us Special",
      "subtitle": "Three reasons to gather around our table",
      "lamb": {
        "title": "35-lb Whole\nRoasted Lamb",
        "desc": "Our showstopper: a whole lamb (~35 lbs) slow-roasted with cumin and Sichuan spices. Feeds 8-15 guests. Reserve at least one week in advance — gloves provided."
      },
      "yurt": {
        "title": "Three Colorful\nMongolian Yurts",
        "desc": "Choose from our white, red, or golden yurt — each nestled among the trees on our New Paltz farm. Warm in winter, breezy in summer. Seats up to 20 guests."
      },
      "farm": {
        "title": "Farm-Raised\n& Homegrown",
        "desc": "We raise our own geese and poultry right here on the farm. Fresh vegetables from our garden, authentic Chinese flavors, and even karaoke after dinner."
      }
    },
    "howItWorks": {
      "title": "How It Works",
      "subtitle": "From booking to feasting — four simple steps",
      "step1": {
        "title": "Choose a Date",
        "desc": "Pick your preferred date and party size"
      },
      "step2": {
        "title": "Pay Deposit",
        "desc": "Secure your reservation with a small deposit"
      },
      "step3": {
        "title": "Pre-Order Menu",
