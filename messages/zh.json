  "landing": {
    "hero": {
      "title": "哈德逊河谷的\n农场到餐桌盛宴",
      "subtitle": "在我们温馨的蒙古包里，品味正宗的蒙古族与东北美食，四周环绕着纽约哈德逊河谷的连绵山丘",
      "bookVisit": "预订您的到访",
      "viewMenu": "查看菜单"
    },
    "about": {
      "title": "我们的故事",
      "para1": "坐落于宁静的哈德逊河谷，波姐农家乐将蒙古族与东北美食的浓郁风味带上您的餐桌。我们的招牌全羊——以明火慢烤，融合传统蒙古香料——是对传统、社区与土地的礼赞。",
      "para2": "在我们的正宗蒙古包中用餐，四周是绿意盎然的牧场与清新的山间空气。每一种食材或来自本地农场，或就地种植于我们的农场。",
      "phone": "(516) 272-9999",
      "location": "纽约，哈德逊河谷"
    },
    "highlights": {
      "title": "我们的特色",
      "subtitle": "围坐餐桌的三大理由",
      "lamb": {
        "title": "招牌\n烤全羊",
        "desc": "我们的压轴之作：整只羊以明火慢烤数小时，佐以传统蒙古香料。可供10-15人享用，最适合庆典聚会。"
      },
      "yurt": {
        "title": "蒙古包用餐",
        "desc": "走进我们正宗的蒙古包，体验独一无二的用餐体验。温馨私密、装饰精美——每顶蒙古包最多可容纳20位宾客。"
      },
      "farm": {
        "title": "农场新鲜食材",
        "desc": "从我们的牧场到您的餐盘。我们自行饲养牲畜、种植时令蔬菜，确保每道菜肴都使用最新鲜、最美味的食材。"
      }
    },
