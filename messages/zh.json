  "landing": {
    "hero": {
      "title": "蒙古包里的\n烤全羊盛宴",
      "subtitle": "哈德逊河谷最独特的用餐体验 —— 正宗中式烤全羊，在传统蒙古包中享用。仅限预约。",
      "bookVisit": "预约蒙古包",
      "viewMenu": "查看菜单"
    },
    "about": {
      "title": "我们的故事",
      "para1": "波姐农家乐是哈德逊河谷唯一能在蒙古包里享用中式烤全羊的地方。老板Jimmy和他的太太波姐——'真正的老板，烹饪天才'——在New Paltz的农场上创造了这个独一无二的体验。",
      "para2": "约上三五好友，戴上手套，手撕35磅完美调味、慢火烤制的全羊。三顶彩色蒙古包掩映在树林间，农场自养家禽，饭后还有卡拉OK——这不只是一顿饭，是一场派对。",
      "phone": "(516) 272-9999",
      "location": "891 Albany Post Rd, New Paltz, NY 12561"
    },
    "highlights": {
      "title": "我们的特色",
      "subtitle": "围坐餐桌的三大理由",
      "lamb": {
        "title": "35磅\n烤全羊",
        "desc": "我们的压轴之作：整只羊（约35磅）用孜然和川味香料慢烤。可供8-15人享用。需提前一周预订——我们提供手套。"
      },
      "yurt": {
        "title": "三顶彩色\n蒙古包",
        "desc": "白色、红色或金色蒙古包任您选择——每一顶都掩映在New Paltz农场的树林间。冬暖夏凉，最多可容纳20位宾客。"
      },
      "farm": {
        "title": "农场自养\n新鲜直供",
        "desc": "我们在农场自养鹅和家禽，菜园里种植新鲜蔬菜。正宗中式风味，饭后还有卡拉OK助兴。"
      }
    },
